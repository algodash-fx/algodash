# Copie ce fichier en ".env" pour tester sur ton PC, puis remplis les valeurs.
# Le fichier .env n'est JAMAIS envoyé sur GitHub (voir .gitignore).
# En production, ces valeurs sont saisies dans les secrets du dépôt GitHub.

# Identifiants de ton compte Myfxbook (e-mail + mot de passe, pas Google/Facebook)
MYFXBOOK_EMAIL=
MYFXBOOK_PASSWORD=

# Fuseau horaire du broker : décalage en heures par rapport à UTC (ex. 3)
# ou nom de fuseau (ex. Europe/Athens). Sert à convertir les heures en heure suisse.
BROKER_TIMEZONE=0
